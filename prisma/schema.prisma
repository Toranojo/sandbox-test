// Prisma schema for the asset tracker MVP.
// Postgres (Supabase). DATABASE_URL is the pooled "Transaction" connection
// (port 6543) used at runtime; DIRECT_URL is the direct connection (port
// 5432) used by `prisma db push` / migrate, which don't work through the
// pooler. See README for how to get these from a Supabase project.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// category/pricingMode are plain strings (not Postgres enums) constrained by
// the app-level types in src/lib/assetCategories.ts (AssetCategory = "GOLD" |
// "PLATINUM" | "SILVER" | "WATCH" | "BAG" | "JEWELRY" | "OTHER", PricingMode =
// "WEIGHT" | "ITEM"), keeping category values changeable without a DB migration.
model Asset {
  id            String        @id @default(cuid())
  category      String
  pricingMode   String

  name          String
  brand         String?
  model         String?
  notes         String?

  // WEIGHT-mode fields (GOLD / PLATINUM / SILVER)
  weightGrams   Float?
  purity        String?

  // ITEM-mode fields (WATCH / BAG / JEWELRY / OTHER)
  quantity      Int           @default(1)

  purchasePrice Int
  purchaseDate  DateTime

  imageUrl      String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([category])
}
